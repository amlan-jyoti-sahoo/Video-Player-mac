{
  "appId": "com.aeroplay.app",
  "productName": "AeroPlay",
  "asar": true,
  "files": [
    "assets/**/*",
    "index.html",
    "main.js",
    "preload.js",
    "script.js",
    "styles.css",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.video",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      }
    ],
    "identity": null,
    "hardenedRuntime": true
  },
  "dmg": {
    "writeUpdateInfo": false
  },
  "forceCodeSigning": false
}